# VideoShorts Configuration

# Active LLM Provider: 'inception' (fast cloud), 'ollama' (offline local), 'gemini', or 'openai'
LLM_PROVIDER=inception

# Inception Labs API Settings
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

# Ollama Settings (Optional offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hardware & Speech Recognition Settings
ASR_DEVICE=cuda
ASR_MODEL_SIZE=small
ASR_COMPUTE_TYPE=float16
ASR_CPU_FALLBACK=true

# Output & Pacing
TARGET_ASPECT_RATIO=9:16
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=60
LOUDNORM_ENABLED=true
